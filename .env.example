# Todas las variables son opcionales: el sitio funciona sin ninguna configurada.

# Cloudinary (opcional) — si se setea, cloudinaryLoader arma URLs de transformación
# (f_auto,q_auto,w_<width>) en vez de pasar el src tal cual.
NEXT_PUBLIC_CLOUDINARY_CLOUD=

# Mux (opcional) — playback id para reemplazar el <video> de MediaVideo por <MuxPlayer>.
NEXT_PUBLIC_MUX_PLAYBACK_ID=

# Sanity (opcional) — completado en Task 2 (CMS).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
